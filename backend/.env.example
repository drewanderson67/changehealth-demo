# Mock mode: true = always return simulated Optum responses, false = always call Optum.
# Leave unset to use mock mode automatically when no sandbox/production eligibility credentials are configured.
# OPTUM_MOCK_MODE=true

# Optum API credentials
# Get these from https://developer.optum.com/

# Used for sandbox eligibility and professional claims requests
OPTUM_SANDBOX_CLIENT_ID=your_sandbox_client_id_here
OPTUM_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret_here

# Used for production eligibility and professional claims requests
OPTUM_PROD_ELIGIBILITY_CLIENT_ID=your_production_eligibility_client_id_here
OPTUM_PROD_ELIGIBILITY_CLIENT_SECRET=your_production_eligibility_client_secret_here

# Used for payer lookup, directory, and export requests.
# The payer-list API always uses the production endpoint, even when the UI is in sandbox mode.
OPTUM_PROD_PAYER_CLIENT_ID=your_production_payer_client_id_here
OPTUM_PROD_PAYER_CLIENT_SECRET=your_production_payer_client_secret_here

# Must be 3001 when running through the repository's Docker Compose configuration.
PORT=3001
